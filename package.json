{
  "name": "@javaabu/i18n",
  "version": "0.0.0",
  "description": "Laravel's __(), trans() and trans_choice() for JavaScript: same API and output, with locale detection from the page and loaders for Laravel JS Localization, JSON, gettext, XLIFF, properties and ARB files. Works with React, Vue, jQuery and vanilla JS.",
  "license": "MIT",
  "author": {
    "name": "Javaabu Pvt. Ltd.",
    "url": "https://javaabu.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javaabu/i18n.git"
  },
  "homepage": "https://github.com/Javaabu/i18n#readme",
  "bugs": {
    "url": "https://github.com/Javaabu/i18n/issues"
  },
  "keywords": [
    "i18n",
    "localization",
    "translation",
    "laravel",
    "lang",
    "react",
    "vue",
    "jquery",
    "javaabu"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/global.js",
    "./dist/global.cjs",
    "./dist/i18n.iife.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/i18n.iife.js",
  "jsdelivr": "./dist/i18n.iife.js",
  "files": [
    "dist",
    "docs",
    "llms.txt",
    "resources",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./jquery": {
      "types": "./dist/jquery.d.ts",
      "import": "./dist/jquery.js",
      "require": "./dist/jquery.cjs"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js",
      "require": "./dist/global.cjs"
    },
    "./browser": "./dist/i18n.iife.js",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.browser.config.ts && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "parity:generate": "cd test/parity && composer install --quiet && php generate.php",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "examples": "vite --config examples/vite.config.ts",
    "examples:build": "vite build --config examples/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jquery": "^4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/compiler-sfc": "^3.5.44",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jquery": "^4.0.0",
    "jsdom": "^30.1.3",
    "lang.js": "^1.1.14",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
